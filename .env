# DriveLegal – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# No API keys required. Ensure Ollama is running locally with the mistral model.
# Command: ollama run mistral

# ── Optional ───────────────────────────────────────────────────────────────
# Backend host/port (defaults shown)
HOST=0.0.0.0
PORT=8000

# Streamlit backend URL (change if deploying remotely)
BACKEND_URL=http://localhost:8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── GPS Settings ────────────────────────────────────────────────────────────
# How long (seconds) before a GPS fix is considered stale (default 60)
GPS_MAX_AGE_SECONDS=60

# Frontend polling interval in milliseconds (default 10000 = 10 seconds)
# This is used as a reference; the actual value is hardcoded in ui.html
GPS_POLL_INTERVAL_MS=10000

# Setting up OTP system 
SMTP_SERVER=
SMTP_PORT=465
SENDER_EMAIL=
SENDER_PASSWORD=
OTP_DEV_FALLBACK=true
JWT_SECRET=
