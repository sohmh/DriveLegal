# Virtual environment - NEVER commit this
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables - NEVER commit
.env

# Qdrant vector database (too large for GitHub - regenerate with scripts/migrate_to_qdrant.py)
data/qdrant_db/
qdrant_db/

# Raw source data (keep the directory placeholder; already tracked files remain tracked)
data/raw/*
!data/raw/.gitkeep

# HuggingFace model cache
*.bin
*.pt
*.pth

# Logs
logs/

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

#qdrant .lock file
*.lock